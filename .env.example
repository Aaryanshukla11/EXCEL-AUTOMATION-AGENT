# Autonomous Excel Intelligence Platform — Environment Configuration
# Copy this file to .env for local overrides (never commit .env to version control)

# Execution environment: production | development | test
EXCEL_INTEL_ENV=development

# Logging configuration: DEBUG | INFO | WARNING | ERROR
EXCEL_INTEL_LOG_LEVEL=INFO
# Log output format: json | text
EXCEL_INTEL_LOG_FORMAT=json

# Root directory for operational workbooks and staging
EXCEL_INTEL_STORAGE_ROOT=.

# Security & Durability
EXCEL_INTEL_TOKEN_TTL_SECONDS=900
EXCEL_INTEL_MAX_RSS_MB=250
EXCEL_INTEL_MAX_DECOMPRESSION_RATIO=10.0
EXCEL_INTEL_MAX_UNCOMPRESSED_BYTES=1073741824
EXCEL_INTEL_WAL_FLUSH_BARRIER=true
EXCEL_INTEL_SQLITE_VAULT_PATH=audit_vault.db
